{
  "expo": {
    "name": "Basa Lagbe",
    "slug": "basa-lagbe",
    "scheme": "basalagbe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.basalagbe.app"
    },
    "android": {
      "package": "com.basalagbe.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Basa Lagbe uses your location to show rental properties near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Basa Lagbe needs access to your photos to add pictures of your property and your profile.",
          "cameraPermission": "Basa Lagbe uses the camera to take your profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}