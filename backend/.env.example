# Copy this file to .env and fill in real values.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/basha_lagbe?schema=public"
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="30d"

# OTP: while true, every code is 123456 and no SMS is sent
OTP_MOCK=true